APP_ENV=development
LOG_LEVEL=INFO
RANDOM_SEED=42
SEC_USER_AGENT="FinHealthAcademicResearch/1.0 (research@example.com)"
SEC_RATE_LIMIT_PER_SEC=8
# Optional PostgreSQL overrides (leave commented to use SQL Server by default):
# POSTGRES_USER=finhealth
# POSTGRES_PASSWORD=finhealth_secret
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=finhealth_db
# SQL Server with Windows Authentication and a locally trusted instance
DATABASE_URL="mssql+pyodbc://ADMIN-PC/finhealth_db?driver=ODBC+Driver+17+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes"
# Enable in one API process after applying migrations to use the SEC refresh button.
INGESTION_WORKER_ENABLED=false
# Allowed browser origins for CORS (JSON array of origin URLs).
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
# Administrator access uses account sessions; there is no development authentication bypass.
PUBLIC_BASE_URL=http://localhost:8000
SESSION_HOURS=8
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP is optional for public browsing and local administrator provisioning.
# Registration and recovery return 503 until real delivery is configured.
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_NAME=FinHealth
MAIL_TIMEOUT_SECONDS=15

# Original interface static root (optional override)
# FRONTEND_DIR=D:/DATN/frontend/legacy
